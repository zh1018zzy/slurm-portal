# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next.bak*/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.pem_bak

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
/logs/
*.log
*.log.*
pm2-*.log
combined-*.log
out-*.log
err-*.log

# local / ephemeral
/test/
/debug/
/tmp/
/data/
*.tmp
*.temp
*~
.swp

# ad-hoc local scripts (keep repo clean)
test-*.js
test-*.ts
test-*.sh
debug-*.js
debug-*.ts
fix_*.js

# backups & archives
*.backup
*.bak
*.bak-*
*.archive
archive-*/
*.tar
*.tar.gz
*.zip
hpc-app-production-*.tar.gz

# uploads
/public/uploads/*
!/public/uploads/.gitkeep

# services / docker scratch
services/*/node_modules/
services/*/logs/
services/*/tmp/
docker/*/logs/
docker/*/tmp/

# IDE / editor / agent local
.vscode/
.idea/
.claude/
.cursor/
*.suo
*.user
.cursor-tutor.code-workspace

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini

# legacy local trees
/dist/
/devdep/
/db-organized/

# ---------- secrets & env (keep .env.example) ----------
.env
.env.*
!.env.example
.passwords

# installation / integrity / commercial license artifacts
config/installation.json
config/installation.json.*
config/.security_markers
config/.security_markers.*
config/.integrity_log
config/license/
config/license-requests/
config/license.json*
config/super-admin.enc
config/super-admin.enc.tmp-*
scripts/license/
scripts/config/license/
scripts/config/licenses/

# ---------- database ----------
# Ignore environment-specific SQL / LDAP dumps; keep public install schemas.
/db/*
!/db/install/
!/db/install/**

# leftover local junk
*.old
*.pid

# local deploy probes / dumps (keep intentional nginx helpers if tracked)
/deploy/*.out
/deploy/host-probe*
/deploy/host-fix*
/deploy/probe-vnc*
/deploy/verify-nss*
/deploy/verify-runuser*
/deploy/*.bak
