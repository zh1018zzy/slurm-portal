{
  "name": "slurm-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Slurm web portal for small-to-medium clusters (Next.js + Slurm + LDAP/NIS + WebShell). Slurm-only.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n app,webshell,job-sync \"npm run dev:app\" \"npm run dev:webshell\" \"npm run dev:job-sync\"",
    "dev:app": "next dev",
    "dev:webshell": "node scripts/tools/webshell-server.js",
    "dev:job-sync": "node scripts/cron/start-job-sync.js",
    "build": "next build",
    "build:offline": "./scripts/deployment/build-offline.sh",
    "start": "next start",
    "lint": "next lint",
    "verify:i18n": "node scripts/verify-i18n.js",
    "verify:env": "bash scripts/deployment/verify-env.sh",
    "setup:super-admin": "node scripts/setup/init-super-admin.js",
    "monitor": "node scripts/operations/performance-monitor.js",
    "monitor:continuous": "node scripts/operations/performance-monitor.js --continuous",
    "diagnose": "node scripts/operations/performance-diagnosis.js",
    "optimize": "chmod +x scripts/operations/optimize-deployment.sh && ./scripts/operations/optimize-deployment.sh",
    "start:prod": "chmod +x scripts/operations/start-production.sh && ./scripts/operations/start-production.sh",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:logs": "pm2 logs hpc-management-platform",
    "pm2:monit": "pm2 monit"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.50.2",
    "@types/archiver": "^6.0.3",
    "@types/prismjs": "^1.26.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "archiver": "^7.0.1",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "form-data": "^4.0.4",
    "formidable": "^3.5.4",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "ldapjs": "^3.0.7",
    "lucide-react": "^0.438.0",
    "next": "14.2.7",
    "next-intl": "^4.3.12",
    "node-cron": "^3.0.3",
    "node-pty": "^1.0.0",
    "nuqs": "^1.19.0",
    "prismjs": "^1.30.0",
    "react": "^18",
    "react-dom": "^18",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.61.1",
    "react-hot-toast": "^2.4.1",
    "react-image": "^4.1.0",
    "react-pdf": "^10.0.1",
    "react-simple-code-editor": "^0.14.1",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^2.15.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.7",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "5.3.3"
  }
}
