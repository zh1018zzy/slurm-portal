# ================= my-hpcapp 环境变量模板 =================
# 复制为 .env 并填写实际值：cp .env.example .env

# ---------- Supabase (PostgreSQL) ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 部分页面使用 NEXT_PUBLIC_ 前缀版本，二者保持一致
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# ---------- 认证 ----------
# 认证方式：linux | ldap
AUTH_MODE=linux
# JWT 签名密钥（自行生成随机串）
JWT_SECRET=change-me-to-a-random-secret

# ---------- LDAP（AUTH_MODE=ldap 时使用） ----------
LDAP_URL=ldap://your-ldap-server:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-password
NEXT_PUBLIC_USER_EMAIL_DOMAIN=example.com
# 用户条目组织单元
LDAP_USERS_OU=ou=users
# 用户 objectClass（逗号分隔，如 inetOrgPerson,posixAccount,top）
LDAP_USER_OBJECTCLASS=inetOrgPerson,posixAccount,top
# posixAccount 相关
LDAP_UID_MIN=10000
LDAP_GID_MIN=10000
LDAP_HOME_PREFIX=/home
# 密码加密方式（plain/ssha/sha 等，推荐 ssha）
LDAP_PASSWORD_HASH=ssha
# 新用户默认 GID（留空则自动分配）
LDAP_DEFAULT_GID=2000

# ---------- 站点 ----------
NEXT_PUBLIC_BASE_URL=http://your-server-ip:3000
NEXT_PUBLIC_SESSION_EXPIRE_MINUTES=1440
LOG_LEVEL=info

# ---------- VNC / noVNC 网关 ----------
# 为防止主机名不通用，请使用 IP 地址
VNC_NODE=
NOVNC_GATEWAY=
NOVNC_PORT=6080
TURBO_VNC_PATH=/opt/TurboVNC/bin
DEFAULT_VNC_NODE_IP=

# ---------- WebShell ----------
WEBSHELL_PORT=3001
NEXT_PUBLIC_WEBSHELL_SERVER=http://your-server-ip:3001
NEXT_PUBLIC_APP_URL=http://your-server-ip:3000
