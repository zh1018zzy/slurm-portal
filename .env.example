# ================= slurm-portal 环境变量模板 =================
# 复制为 .env 并填写实际值：cp .env.example .env
# 部署前请阅读：docs/deployment/cluster-prerequisites.md
# 填写后校验：npm run verify:env

# ---------- Supabase (PostgreSQL) ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 部分页面使用 NEXT_PUBLIC_ 前缀版本，二者保持一致
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# ---------- 认证 ----------
# 认证方式：linux | ldap
AUTH_MODE=linux
# JWT 签名密钥（自行生成随机串）
JWT_SECRET=change-me-to-a-random-secret
# 可选：超级管理员凭证专用加密密钥（不设则回退使用 JWT_SECRET）
# SUPER_ADMIN_CRYPTO_KEY=

# ---------- LDAP（AUTH_MODE=ldap 时使用） ----------
LDAP_URL=ldap://your-ldap-server:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-password
NEXT_PUBLIC_USER_EMAIL_DOMAIN=example.com
# 用户条目组织单元
LDAP_USERS_OU=ou=users
# 用户 objectClass（逗号分隔，如 inetOrgPerson,posixAccount,top）
LDAP_USER_OBJECTCLASS=inetOrgPerson,posixAccount,top
# posixAccount 相关
LDAP_UID_MIN=10000
LDAP_GID_MIN=10000
LDAP_HOME_PREFIX=/home
# 密码加密方式（plain/ssha/sha 等，推荐 ssha）
LDAP_PASSWORD_HASH=ssha
# 新用户默认 GID（留空则自动分配）
LDAP_DEFAULT_GID=2000

# ---------- 站点 ----------
NEXT_PUBLIC_BASE_URL=http://your-server-ip:3000
NEXT_PUBLIC_SESSION_EXPIRE_MINUTES=1440
LOG_LEVEL=info

# ---------- VNC / noVNC ----------
# 必填建议：Slurm graphics 节点主机名（本机可 ssh；建议 /etc/hosts 或 DNS）
# 未设置时会尝试 sinfo -p graphics，再回退 localhost
VNC_NODE=compute-node-01
# 可选：浏览器访问 noVNC 的主机；不填则自动解析 VNC_NODE
# NOVNC_GATEWAY=
NOVNC_PORT=6080
TURBO_VNC_PATH=/opt/TurboVNC/bin/
# 极少用：覆盖 noVNC URL 的 host=（默认 localhost，适配本机 websockify）
# VNC_URL_HOST=localhost
# 兼容旧变量（与 VNC_NODE 等价，勿再写死局域网 IP）
# DEFAULT_VNC_NODE_IP=
# 多节点高级覆盖（一般不需要）
# NODE_IP_MAP={"node1":"10.0.0.1"}

# ---------- WebShell ----------
WEBSHELL_PORT=3001
NEXT_PUBLIC_WEBSHELL_SERVER=http://your-server-ip:3001
NEXT_PUBLIC_APP_URL=http://your-server-ip:3000
