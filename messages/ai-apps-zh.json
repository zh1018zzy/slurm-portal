            "default": {
              "label": "中等模型 (13B-30B)",
              "description": "1x A100-80GB, 16核CPU, 128GB内存"
            },
            "largeModel": {
              "label": "大模型 (70B)",
              "description": "4x A100-80GB, 32核CPU, 256GB内存"
