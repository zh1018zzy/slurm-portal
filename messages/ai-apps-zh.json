          "options": {
            "2048": {
              "label": "2048 tokens",
              "description": "短文本处理"
            },
            "4096": {
              "label": "4096 tokens",
              "description": "标准长度"
            },
            "8192": {
              "label": "8192 tokens",
              "description": "长文本处理"
            },
            "16384": {
              "label": "16384 tokens",
