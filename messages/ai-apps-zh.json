        "topP": {
          "label": "Top-P",
          "description": "核采样概率阈值 (0.0-1.0)"
        },
        "maxTokens": {
          "label": "最大生成tokens",
          "description": "每个prompt生成的最大token数"
        }
      },
      "layout": {
        "sections": {
          "basicConfig": {
            "title": "基础配置"
          },
          "modelConfig": {
            "title": "模型配置"
          },
          "inferenceParams": {
            "title": "推理参数"
          },
          "jobSettings": {
            "title": "作业设置"
          }
        }
      },
      "io": {
        "inputs": {
          "prompts": {
            "description": "批量推理的输入prompts"
