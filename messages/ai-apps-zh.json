{
  "aiApplications": {
    "title": "AI应用中心",
    "description": "深度学习框架、大模型推理、交互式开发环境",
    "loadFailed": "加载AI应用失败",
    "registerSuccess": "AI应用注册成功",
    "registerFailed": "AI应用注册失败",
    "cacheCleared": "缓存已清除",
    "unknownError": "未知错误"
  },
  "hpcApps": {
    "pytorch": {
      "metadata": {
        "displayName": "PyTorch 深度学习框架",
        "description": "强大的深度学习框架，支持GPU加速训练和推理"
      },
      "resources": {
        "profiles": {
          "default": {
            "description": "标准GPU训练配置 (1x A100, 8核, 32GB)"
          },
          "smallGpu": {
            "description": "小规模训练 (1x RTX3090, 4核, 16GB)"
          },
          "multiGpu": {
            "description": "多GPU训练 (4x A100, 16核, 64GB)"
          },
          "distributed": {
            "description": "分布式训练 (4节点, 16x GPU)"
          }
        }
      },
      "execution": {
        "modes": {
          "singleGpu": {
            "description": "单GPU训练模式"
          },
          "multiGpu": {
            "description": "多GPU DataParallel训练"
          },
          "distributedDdp": {
            "description": "分布式DistributedDataParallel训练"
          }
        },
        "templates": {
          "singleGpu": {
            "description": "单GPU训练模板"
          },
          "multiGpu": {
            "description": "多GPU训练模板"
          },
          "distributedDdp": {
            "description": "分布式训练模板"
          }
        }
      },
      "fields": {
        "jobName": {
          "label": "作业名称",
          "description": "PyTorch训练作业的唯一标识"
        },
        "executionMode": {
          "label": "执行模式",
          "description": "选择单GPU、多GPU或分布式训练模式",
          "options": {
            "singleGpu": {
              "label": "单GPU训练",
              "description": "在单个GPU上训练模型"
            },
            "multiGpu": {
              "label": "多GPU训练",
              "description": "使用DataParallel在多个GPU上训练"
            },
            "distributedDdp": {
              "label": "分布式训练 (DDP)",
              "description": "使用DistributedDataParallel跨节点训练"
            }
          }
        },
        "resourceProfile": {
          "label": "资源配置",
          "description": "选择预设的资源配置方案",
          "options": {
            "default": {
              "label": "标准配置",
              "description": "1x A100, 8核CPU, 32GB内存"
            },
            "smallGpu": {
              "label": "小规模配置",
              "description": "1x RTX3090, 4核CPU, 16GB内存"
            },
            "multiGpu": {
              "label": "多GPU配置",
              "description": "4x A100, 16核CPU, 64GB内存"
            },
            "distributed": {
              "label": "分布式配置",
              "description": "4节点, 每节点4x GPU"
            }
          }
        },
        "inputType": {
          "label": "输入类型",
          "description": "选择上传脚本文件或直接输入代码",
          "options": {
            "script": {
              "label": "脚本文件",
              "description": "上传Python训练脚本"
            },
            "code": {
              "label": "代码片段",
              "description": "直接输入Python代码"
            }
          }
        },
        "scriptFile": {
          "label": "训练脚本",
          "description": "上传PyTorch训练脚本 (.py文件)"
        },
        "scriptArgs": {
          "label": "脚本参数",
          "description": "传递给训练脚本的命令行参数",
          "placeholder": "例如: --lr 0.001 --epochs 100"
        },
        "pythonCode": {
          "label": "Python代码",
          "description": "直接输入要执行的Python代码",
          "placeholder": "import torch\\nprint(torch.__version__)"
        },
        "dataFiles": {
          "label": "数据文件",
          "description": "上传训练数据文件 (可选)"
        },
        "gpuType": {
          "label": "GPU类型",
          "description": "选择GPU型号",
          "options": {
            "a100": {
              "label": "NVIDIA A100",
              "description": "80GB HBM2e显存, 适合大模型训练"
            },
            "v100": {
              "label": "NVIDIA V100",
              "description": "32GB HBM2显存, 通用深度学习"
            },
            "rtx3090": {
              "label": "NVIDIA RTX 3090",
              "description": "24GB GDDR6X显存, 性价比高"
            }
          }
        },
        "gpuCount": {
          "label": "GPU数量",
          "description": "使用的GPU卡数",
          "options": {
            "1": { "label": "1块GPU" },
            "2": { "label": "2块GPU" },
            "4": { "label": "4块GPU" },
            "8": { "label": "8块GPU" }
          }
        },
        "walltime": {
          "label": "运行时长",
          "description": "作业最长运行时间",
          "options": {
            "1hour": { "label": "1小时" },
            "2hours": { "label": "2小时" },
            "4hours": { "label": "4小时" },
            "8hours": { "label": "8小时" },
            "12hours": { "label": "12小时" },
            "24hours": { "label": "24小时" },
            "48hours": { "label": "48小时" },
            "72hours": { "label": "72小时" }
          }
        }
      },
      "layout": {
        "sections": {
          "basicConfig": {
            "title": "基础配置"
          },
          "trainingScript": {
            "title": "训练脚本"
          },
          "dataFiles": {
            "title": "数据文件"
          },
          "gpuResources": {
            "title": "GPU资源"
          }
        }
      },
      "io": {
        "inputs": {
          "trainingScript": {
            "description": "PyTorch训练脚本"
          },
          "dataset": {
            "description": "训练数据集目录"
          },
          "checkpoint": {
            "description": "预训练模型checkpoint"
          },
          "config": {
            "description": "训练配置文件"
          }
        },
        "outputs": {
          "model": {
            "description": "训练完成的模型权重"
          },
          "logs": {
            "description": "训练日志和指标"
          },
          "checkpoints": {
            "description": "训练过程中的checkpoint"
          },
          "tensorboard": {
            "description": "TensorBoard事件文件"
          }
        }
      }
    },
    "vllm": {
