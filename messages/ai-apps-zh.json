          "options": {
            "2hours": { "label": "2小时" },
            "4hours": { "label": "4小时" },
            "8hours": { "label": "8小时" },
            "12hours": { "label": "12小时" },
            "24hours": { "label": "24小时" },
            "48hours": { "label": "48小时" }
          }
        },
        "inputFile": {
          "label": "输入文件",
          "description": "包含prompts的文本文件"
        },
        "temperature": {
          "label": "Temperature",
          "description": "采样温度，控制随机性 (0.0-2.0)"
