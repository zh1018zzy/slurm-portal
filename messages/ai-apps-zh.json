      },
      "resources": {
        "profiles": {
          "default": {
            "description": "标准LLM推理配置 (7B-13B模型)"
          },
          "smallModel": {
            "description": "7B模型配置 (1x A100-40GB)"
          },
          "mediumModel": {
            "description": "13B-30B模型配置 (1x A100-80GB)"
          },
          "largeModel": {
            "description": "70B模型配置 (4x A100-80GB)"
          },
          "xlargeModel": {
            "description": "175B+模型配置 (8x A100-80GB)"
          }
        }
      },
      "execution": {
        "modes": {
          "apiServer": {
            "description": "OpenAI兼容的API服务器"
          },
          "offlineInference": {
            "description": "离线批量推理"
          }
        },
        "templates": {
          "vllmServer": {
            "description": "vLLM OpenAI兼容API服务器"
