          "label": "量化方法",
          "description": "模型量化以节省显存",
          "options": {
            "none": {
              "label": "无量化",
              "description": "使用完整精度"
            },
            "awq": {
              "label": "AWQ量化",
              "description": "激活感知权重量化"
            },
            "gptq": {
              "label": "GPTQ量化",
              "description": "生成式预训练Transformer量化"
            },
            "squeezellm": {
              "label": "SqueezeLLM",
              "description": "SqueezeLLM量化"
            }
          }
        },
        "dtype": {
          "label": "数据类型",
          "description": "模型权重的数据类型",
          "options": {
            "auto": {
              "label": "自动",
              "description": "自动选择最佳精度"
            },
            "float16": {
              "label": "FP16",
              "description": "半精度浮点"
            },
            "bfloat16": {
              "label": "BF16",
              "description": "脑浮点格式"
            }
          }
